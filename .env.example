# Application
APP_NAME=SafariSmart AI Concierge
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api

# PostgreSQL
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/safarismart

# Africa's Talking
AFRICASTALKING_USERNAME=<your-sandbox-username>
