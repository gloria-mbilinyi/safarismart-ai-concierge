# Application
APP_NAME=SafariSmart AI Concierge
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api

# Authentication (generate a strong random value; never commit the populated value)
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_ISSUER=safarismart-api
AUTH_AUDIENCE=safarismart-operator

# PostgreSQL
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/safarismart

# Africa's Talking SMS (disabled and sandbox-only by default)
SMS_ENABLED=false
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# LLM provider
LLM_API_KEY=<your-llm-api-key>
