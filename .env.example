# Application
APP_NAME=SafariSmart AI Concierge
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication (generate a strong random value; never commit the populated value)
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_ISSUER=safarismart-api
AUTH_AUDIENCE=safarismart-operator

# PostgreSQL
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/safarismart

# Docker Compose local demo (set a URL-safe random password before startup)
POSTGRES_PASSWORD=
WEB_PORT=8080

# Africa's Talking SMS (disabled and sandbox-only by default)
SMS_ENABLED=false
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Grounded concierge (deterministic fallback requires no model or API key)
AI_PROVIDER=fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=5

# Public USSD callback safety (per opaque session, single API process)
USSD_RATE_LIMIT_PER_MINUTE=30
USSD_RATE_LIMIT_MAX_SESSIONS=10000
